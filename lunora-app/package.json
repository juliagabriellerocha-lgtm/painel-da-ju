{
  "name": "lunora-app",
  "version": "1.0.0",
  "private": true,
  "description": "Lunora para iPhone (Capacitor) — empacota o app web da pasta lunora/",
  "scripts": {
    "web": "node scripts/copy-web.mjs",
    "sync": "npm run web && npx cap sync ios",
    "icons": "npx capacitor-assets generate --ios --iconBackgroundColor '#1F1530' --splashBackgroundColor '#1F1530'"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@capgo/capacitor-speech-recognition": "^8.4.6",
    "@ebarooni/capacitor-calendar": "^8.10.0"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0"
  }
}
